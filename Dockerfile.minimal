# Minimal Hermes Agent image for SDK use (HTTP gateway only).
#
# Excludes vs the main Dockerfile:
#   - Playwright + Chromium (~500MB)        — browser tools
#   - nodejs / npm + npm install            — web dashboard, TUI Ink renderer
#   - web/ and ui-tui/ build steps          — dashboard SPA, TUI assets
#   - ffmpeg, ripgrep, openssh-client       — voice/video, search, SSH backend
#   - The full ".[all]" extras              — telegram, discord, voice/STT,
#                                             matrix, modal, daytona, vercel,
#                                             rl, etc.
#
# Includes everything needed for `hermes gateway run` with the API server
# platform: core agent loop, gateway, cron, skills, providers, plus aiohttp
# (the API server's HTTP framework, not in core deps).
#
# Build:
#   docker build -f Dockerfile.minimal -t hermes-agent:minimal .
#
# Use from the SDK:
#   Hermes.via_docker(image="hermes-agent:minimal")
#
# Result: ~5-10x smaller than the default image.

FROM ghcr.io/astral-sh/uv:0.11.6-python3.13-trixie@sha256:b3c543b6c4f23a5f2df22866bd7857e5d304b67a564f4feab6ac22044dde719b AS uv_source
FROM tianon/gosu:1.19-trixie@sha256:3b176695959c71e123eb390d427efc665eeb561b1540e82679c15e992006b8b9 AS gosu_source
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1

# tini    — reaps zombie processes when running as PID 1
# git     — model/skill loaders that pull from git repos
# procps  — `ps` is used by hermes_state.py for process checks
# curl    — health checks
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        tini git procps curl && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -u 10000 -m -d /opt/data hermes

COPY --chmod=0755 --from=gosu_source /gosu /usr/local/bin/
COPY --chmod=0755 --from=uv_source /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

WORKDIR /opt/hermes

# Source — selectively copy only what `hermes gateway run` needs at runtime.
# Skip: web/, ui-tui/, environments/, tinker-atropos/, tests/, docs/,
#       website/, plans/, .plans/, datagen-config-examples/.
COPY --chown=hermes:hermes pyproject.toml README.md hermes ./
COPY --chown=hermes:hermes \
    run_agent.py model_tools.py toolsets.py batch_runner.py \
    trajectory_compressor.py toolset_distributions.py cli.py \
    hermes_constants.py hermes_state.py hermes_time.py hermes_logging.py \
    utils.py mcp_serve.py mini_swe_runner.py rl_cli.py \
    cli-config.yaml.example .env.example \
    ./
COPY --chown=hermes:hermes agent ./agent
COPY --chown=hermes:hermes tools ./tools
COPY --chown=hermes:hermes hermes_cli ./hermes_cli
COPY --chown=hermes:hermes gateway ./gateway
COPY --chown=hermes:hermes cron ./cron
COPY --chown=hermes:hermes acp_adapter ./acp_adapter
COPY --chown=hermes:hermes plugins ./plugins
COPY --chown=hermes:hermes providers ./providers
COPY --chown=hermes:hermes tui_gateway ./tui_gateway
COPY --chown=hermes:hermes skills ./skills
COPY --chown=hermes:hermes locales ./locales
COPY --chown=hermes:hermes docker ./docker
COPY --chown=hermes:hermes hermes_sdk.py ./

USER root
RUN chmod -R a+rX /opt/hermes

# Core install only. Add aiohttp explicitly (the API server platform imports
# it but it's not in the core pyproject deps). Add [mcp] so the MCP server
# (`hermes mcp serve` and the streamable-HTTP variant) works — needed when
# the SDK calls Hermes.via_docker(expose_mcp=True).
RUN uv venv && \
    uv pip install --no-cache-dir -e ".[mcp]" && \
    uv pip install --no-cache-dir aiohttp

ENV HERMES_HOME=/opt/data
ENV PATH="/opt/data/.local/bin:${PATH}"
# 8642 — gateway HTTP API ; 8000 — MCP over streamable HTTP (when enabled
# at run-time via HERMES_MCP_HTTP_PORT).
EXPOSE 8642 8000
VOLUME [ "/opt/data" ]
ENTRYPOINT [ "/usr/bin/tini", "-g", "--", "/opt/hermes/docker/entrypoint.sh" ]
